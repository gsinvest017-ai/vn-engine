// Chet 風小號：open / harmon（CC110 切換）＋氣音層；自動產生：tools/video/jazz_arrange.py sfz
// 樣本 VSCO-2-CE（CC0）
<control>
default_path=../../_assets/lib/VSCO-2-CE/Brass/Trumpet/

<global>
