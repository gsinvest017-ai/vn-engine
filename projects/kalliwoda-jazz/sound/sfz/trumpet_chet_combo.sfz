// 氣音：帶通雜訊，起音明顯、持續音時很淡
<master> volume=-48 fil_type=bpf_2p cutoff=5000 ampeg_attack=0.01 ampeg_decay=0.22 ampeg_sustain=25 ampeg_release=0.2 amp_veltrack=100
<region> sample=*noise lokey=47 hikey=90
